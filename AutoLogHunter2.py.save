# Import argparse to handle command-line arguments
import argparse

# Function to parse command-line arguments
def parse_arguments():
    """
    Sets up and parses the command-line arguments for the tool.
    - Required: log file path
    - Optional: keywords to search for in the log
    """
    parser = argparse.ArgumentParser(description='AutoLogHunter - Simple log analysis tool.')
    parser.add_argument('-l', '--log', required=True, help='Path to the log file')
    parser.add_argument('-k', '--keywords', nargs='+', help='Keywords to search for (e.g., "Failed password")')
    return parser.parse_args()

# Function to read the log file
import argparse
import re
from collections import defaultdict

def parse_arguments():
    """
    Parses command-line arguments for log file path and keywords.
    """
    parser = argparse.ArgumentParser(description='AutoLogHunter - Enhanced log analysis tool.')
    parser.add_argument('-l', '--log', required=True, help='Path to the log file')
    parser.add_argument('-k', '--keywords', nargs='+', help='Keywords to search for (e.g., "Failed password")')
    return parser.parse_args()

def read_log_file(log_path):
    """
    Reads and returns lines from the specified log file.
    """
    try:
        with open(log_path, 'r') as file:
            return file.readlines()
    except FileNotFoundError:
        print(f"[!] Log file not found: {log_path}")
        exit(1)

def tag_severity(line):
	if 'failed password' in line.lower():
		return 'CRITICAL'
	elif 'invalid user' in line.lower():
		return 'WARNING'
	elif 'session opened' in line.lower() or 'accepted password' in line.lower():
		return 'INFO'
	else:
		return 'UNKNOWN'

def extract_ip(line):
    """
    Uses regex to extract the first IP address from a line.
    Returns None if no IP is found.
    """
    ip_match = re.search(r'(\d{1,3}(?:\.\d{1,3}){3})', line)
    return ip_match.group(1) if ip_match else None

def find_anomalies_and_ips(log_lines, keywords):
    """
    Searches for keyword matches in log lines,
    extracts IP addresses from matching lines,
    and counts frequency of IPs.
    """
    anomalies = []
    ip_counter = defaultdict(int)  # default value of 0

    for line in log_lines:
        if any(keyword in line for keyword in keywords):
            clean_line = line.strip()
            anomalies.append(clean_line)
            
            ip = extract_ip(clean_line)
            if ip:
                ip_counter[ip] += 1

    return anomalies, ip_counter

def print_results(anomalies, ip_counter, keywords):
    """
    Displays anomalies and top IP offenders.
    """
    print(f"\n[+] Found {len(anomalies)} anomalies with these keywords: {keywords}\n")

    # Print each matched log line
    for line in anomalies:
        print(f"    → {line}")

    # Print IP counts if any were found
    if ip_counter:
        print("\n[+] Suspicious IP address frequency:")
        for ip, count in sorted(ip_counter.items(), key=lambda x: x[1], reverse=True):
            print(f"    - {ip}: {count} times")

def main():
    args = parse_arguments()
    print(f"[+] Log File: {args.log}")
    print(f"[+] Keywords: {args.keywords}")

    log_lines = read_log_file(args.log)
    anomalies, ip_counter = find_anomalies_and_ips(log_lines, args.keywords)
    print_results(anomalies, ip_counter, args.keywords)

if __name__ == "__main__":
    main()

